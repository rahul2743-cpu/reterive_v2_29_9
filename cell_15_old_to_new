# ==========================================================
# Cell 15 : QUERY -> ENTITY PHRASES (seed-node extraction)
#
#           The only LLM call before retrieval. It does NOT answer the
#           question. It only picks the TECHNICAL terms in the question
#           that will be looked up as seed nodes in the knowledge graph
#           (Cell 16). Everything downstream is deterministic graph work.
# ==========================================================
from difflib import SequenceMatcher

print("=" * 80)
print("CELL 15 — QUERY ENTITY EXTRACTION")
print("=" * 80)

EXTRACT_PROMPT = """You are a technical entity extractor for a systems-engineering
knowledge graph. Your output is used to pick SEED NODES in the graph, so precision
matters more than quantity. A wrong or generic entity pulls in the wrong part of
the graph.

TASK
Read the question and return only the TECHNICAL TERMS that name a specific
thing. The most important technical term in the question must come first.

WHAT COUNTS AS A TECHNICAL ENTITY
- System        : an engineered system or subsystem (e.g. "hydraulic braking system", "engine"),
                  and also a software tool, platform or product (e.g. "Intellisearch", "PLM tool")
- Component     : a physical or logical part (e.g. "pressure sensor", "ECU", "actuator")
- ControlFactor : a design/control parameter that can be set or tuned (e.g. "gain", "sampling rate")
- NoiseFactor   : an uncontrollable disturbance (e.g. "ambient temperature", "vibration")
- ErrorState    : a failure mode, fault or defect (e.g. "sensor drift", "short circuit")
- Method        : a technique, algorithm or analysis (e.g. "FMEA", "Taguchi method", "Kalman filter")
- Procedure     : a defined process or test (e.g. "calibration procedure", "hazard analysis")
- Standard      : a standard, regulation or document ID (e.g. "ISO 26262", "IEC 61508")
- Concept       : a specific technical concept or measured quantity
                  (e.g. "robust design", "signal-to-noise ratio", "oil consumption"),
                  and also a kind of document or artifact when the question is about it
                  (e.g. "document", "requirements document", "test report")

RULES
1. Copy the phrase as it appears in the question. If a word in the phrase is
   clearly misspelled, return the correct spelling. Do not add other words.
2. Keep multi-word technical terms together as ONE entity. Return
   "signal-to-noise ratio", not "signal", "noise", "ratio".
3. Keep acronyms, product names and identifiers as written
   (FMEA, ISO 26262, ECU, Intellisearch).
4. Use the shortest phrase that still names the thing.
   Drop leading articles and generic modifiers ("the", "a", "main", "different").
5. Do NOT return any of these:
   - question words (what, why, how, which, when, explain, describe)
   - verbs, adjectives, adverbs (allow, find, used, use, calculate)
   - generic words: process, system (alone), information, way, approach,
     type, example, difference, purpose, role, importance, effect, step, user(s)
   - anything not written in the question. Never add synonyms or expansions.
6. If a generic word is part of a specific term, keep the full term
   ("calibration procedure" is valid, "procedure" alone is not).
   Words like "provided procedure" or "given method" are NOT specific terms.
7. A document or artifact word ("document", "report", "manual") IS valid when the
   question asks about that thing, because it is the subject of the question.
8. A measured quantity or performance limit (e.g. "oil consumption",
   "fuel efficiency", "maximum allowable pressure") IS a valid entity.
   Return the full phrase AND its core term when the core term is itself
   a technical thing (e.g. "maximum allowable oil consumption" and "oil consumption").
   The measured quantity is usually the main subject, so list it before the
   system it belongs to.
9. No duplicates (singular and plural count as the same entity).
   Order by importance to the question, most important first.
10. Choose the single best class for each entity from the list above.
    If unsure between two, use Concept.

OUTPUT FORMAT
One record per line, exactly:
<entity phrase>|<class>
No preamble, no markdown, no numbering, no explanation.
If the question contains no technical entity, output exactly: NONE

EXAMPLES
Question: What is the role of FMEA in ensuring ISO 26262 compliance for the braking ECU?
FMEA|Method
ISO 26262|Standard
braking ECU|Component

Question: How does ambient temperature cause sensor drift in the pressure sensor?
ambient temperature|NoiseFactor
sensor drift|ErrorState
pressure sensor|Component

Question: Explain the difference between control factors and noise factors in Taguchi method.
control factors|ControlFactor
noise factors|NoiseFactor
Taguchi method|Method

Question: What type of document does Intellisearch allow users to find, and what are these documents used for?
Intellisearch|System
document|Concept

Question: How do you calculate the maximum allowable oil consumption for an engine according to the provided procedure?
maximum allowable oil consumption|Concept
oil consumption|Concept
engine|System

Question: What is the best way to do this?
NONE"""

# Generic words that must never become a seed node on their own
_GENERIC = {
    "process", "system", "systems", "information", "way", "approach", "type",
    "types", "example", "examples", "difference", "purpose", "role",
    "importance", "effect", "use", "step", "steps", "thing", "things",
    "user", "users", "what", "why", "how", "which", "when", "who",
    "explain", "describe", "procedure", "provided procedure",
}

_VALID_CLASSES = {
    "System", "Component", "ControlFactor", "NoiseFactor", "ErrorState",
    "Method", "Procedure", "Standard", "Concept",
}

_MAX_ENTITIES = 8


def _normalize(text: str) -> str:
    """
    Lower-case, treat hyphens/underscores as spaces, and strip a trailing
    plural 's' from each word so 'documents' == 'document' and
    'control factors' == 'control factor'. Used only for comparison.
    """
    words = text.lower().replace("-", " ").replace("_", " ").split()
    return " ".join(w[:-1] if len(w) > 3 and w.endswith("s") else w for w in words)


def _in_question(key: str, q_norm: str, threshold: float = 0.85) -> bool:
    """
    True if the normalised phrase appears in the normalised question,
    allowing small spelling errors (e.g. 'consumption' vs 'comsumption').
    """
    if key in q_norm:
        return True
    n = len(key.split())
    q_words = q_norm.split()
    for i in range(len(q_words) - n + 1):
        window = " ".join(q_words[i:i + n])
        if SequenceMatcher(None, key, window).ratio() >= threshold:
            return True
    return False


def extract_query_entities(question: str):
    """
    Extract technical entity phrases from a user question via LLM.

    Args:
        question (str): The user's natural-language question.

    Returns:
        list[tuple[str, str]]: (phrase, class_hint) pairs, most important first.
            phrase     : technical phrase found in the question
            class_hint : System, Component, ControlFactor, NoiseFactor,
                         ErrorState, Method, Procedure, Standard or Concept

    Behaviour:
        - Never raises. LLM failure degrades to [].
        - "NONE" from the LLM returns [].
        - Code-level filters remove generic words, duplicates, and any phrase
          that does not appear in the question (hallucination guard).
          Matching ignores case, hyphens and plural 's', and tolerates
          small spelling errors in the user's question.
        - Cell 16 falls back to lexical matching when [] is returned.
    """
    try:
        resp = driver_llm.invoke([
            {"role": "system", "content": EXTRACT_PROMPT},
            {"role": "user", "content": f"Question: {question}"},
        ])
        text = resp.content.strip()
    except Exception as e:
        print(f"  entity extraction failed ({e}) -- lexical fallback")
        return []

    if text.upper().startswith("NONE"):
        return []

    q_norm = _normalize(question)
    out, seen = [], set()

    for line in text.splitlines():
        line = line.strip().lstrip("-*0123456789. ").strip()
        if not line or "|" not in line:
            continue

        phrase, cls = line.split("|", 1)
        phrase = phrase.strip().strip("\"'`")
        cls = cls.strip()

        if not phrase:
            continue
        key = _normalize(phrase)

        # 1. drop generic words
        if key in _GENERIC or phrase.lower() in _GENERIC:
            continue
        # 2. hallucination guard (fuzzy, tolerates typos in the question)
        if not _in_question(key, q_norm):
            continue
        # 3. dedupe (singular/plural treated the same)
        if key in seen:
            continue
        # 4. normalise class
        if cls not in _VALID_CLASSES:
            cls = "Concept"

        seen.add(key)
        out.append((phrase, cls))

        if len(out) >= _MAX_ENTITIES:
            break

    return out


print("Defined: extract_query_entities(question)")
