# ==========================================================
# CELL 16B — SPARQL GRAPH TRAVERSAL (from 16A seed nodes)
# ==========================================================
# Input : seed_nodes, linked_entities, NODE_LABEL (Cell 16A)
#         g, PREFIXES, MAX_HOPS, HOP_DECAY, MAX_FRONTIER,
#         MAX_EDGES, MIN_EDGE_STRENGTH (Cell 13)
# Output: seeds, reached_nodes, all_edges, edges_df
# ==========================================================

import re
from collections import defaultdict

import pandas as pd
from rdflib import URIRef

print("=" * 80)
print("CELL 16B — SPARQL GRAPH TRAVERSAL")
print("=" * 80)

# ----------------------------------------------------------
# Guards
# ----------------------------------------------------------
REQUIRED = (
    "g", "PREFIXES", "MAX_HOPS", "HOP_DECAY", "MAX_FRONTIER",
    "MAX_EDGES", "MIN_EDGE_STRENGTH",
    "linked_entities", "seed_nodes", "NODE_LABEL",
)
_missing = [n for n in REQUIRED if n not in globals()]
if _missing:
    raise RuntimeError(f"{_missing} not defined. Run Cells 13, 15 and 16A first.")

# Optional: text per node, fetched in a later cell
node_content = globals().get("node_content", {})

BEST_PATH_EDGES_ONLY = False
STRENGTH_SCALE = 10.0     # edge strength is on a 0-10 scale (same as before)


def label_of(uri: str) -> str:
    return NODE_LABEL.get(uri, re.split(r"[/#]", str(uri))[-1])


def short(uri) -> str:
    return re.split(r"[/#]", str(uri))[-1]


# ----------------------------------------------------------
# 1. Build seeds from 16A
# ----------------------------------------------------------
def build_seeds(linked: list[dict], seed_uris: list[str]) -> list[dict]:
    by_node = {h["node"]: h for h in linked}
    seeds = []
    for node in seed_uris:
        h = by_node.get(node, {})
        seeds.append({
            "node": str(node),
            "label": label_of(str(node)),
            "score": h.get("score", 0.0) / 100.0,   # 16A scores are 0-100 -> 0-1
            "phrase": h.get("phrase"),
            "match_type": h.get("match_type"),
        })
    return seeds


seeds = build_seeds(linked_entities, seed_nodes)

# ----------------------------------------------------------
# 2. Outgoing edges query
# ----------------------------------------------------------
OUT_QUERY = PREFIXES + """
SELECT ?target ?predicate ?strength ?description ?linkType
WHERE {
    ?statement a rdf:Statement ;
               rdf:subject     ?source ;
               rdf:predicate   ?predicate ;
               rdf:object      ?target ;
               ex:strength     ?strength ;
               ex:description  ?description ;
               ex:linkType     ?linkType .
    FILTER ( isIRI(?target) )
}
"""


def outgoing(node: str) -> list[dict]:
    """
    Outgoing relationships of one node.
    Duplicate RDF statements with the same predicate + target
    keep only the strongest edge.
    """
    best = {}
    for row in g.query(OUT_QUERY, initBindings={"source": URIRef(node)}):
        try:
            strength = int(row.strength)
        except (TypeError, ValueError):
            strength = 0
        key = (str(row.predicate), str(row.target))
        if key not in best or strength > best[key]["strength"]:
            best[key] = {
                "target": str(row.target),
                "predicate": str(row.predicate),
                "strength": strength,
                "description": str(row.description),
                "link_type": str(row.linkType),
            }
    return list(best.values())


# ----------------------------------------------------------
# 3. Traversal
# ----------------------------------------------------------
def traverse(seeds: list[dict]):
    reached, all_edges = {}, []

    # HOP 0 — seeds
    for s in seeds:
        reached[s["node"]] = {
            "label": s["label"], "hop": 0, "root_seed": s["node"],
            "seed_score": s["score"], "path_strength": 1.0,
            "graph_score": s["score"], "parent": None,
            "predicate": None, "strength": None, "description": None,
        }
    frontier = [s["node"] for s in seeds]
    edge_cap_hit = False

    # HOP 1 .. MAX_HOPS
    for hop in range(1, MAX_HOPS + 1):
        print("\n" + "=" * 80)
        print(f"HOP {hop}")
        print("=" * 80)
        print(f"Current frontier size : {len(frontier)}")
        if not frontier:
            print("No nodes available for this hop.")
            break

        new_nodes = {}
        for src in frontier:
            for e in outgoing(src):
                if len(all_edges) >= MAX_EDGES:
                    edge_cap_hit = True
                    break
                if e["strength"] < MIN_EDGE_STRENGTH:
                    continue

                tgt = e["target"]
                if tgt in reached:
                    continue

                parent = reached[src]
                path_strength = parent["path_strength"] * e["strength"] / STRENGTH_SCALE
                hop_decay = 1.0 if hop == 1 else HOP_DECAY ** (hop - 1)
                graph_score = parent["seed_score"] * path_strength * hop_decay

                all_edges.append({
                    "hop": hop, "source": src, "target": tgt,
                    "predicate": e["predicate"], "strength": e["strength"],
                    "description": e["description"], "link_type": e["link_type"],
                    "root_seed": parent["root_seed"],
                    "hop_decay": hop_decay, "graph_score": graph_score,
                })

                info = {
                    "label": label_of(tgt), "hop": hop,
                    "root_seed": parent["root_seed"],
                    "seed_score": parent["seed_score"],
                    "path_strength": path_strength, "graph_score": graph_score,
                    "parent": src, "predicate": short(e["predicate"]),
                    "strength": e["strength"], "description": e["description"],
                }
                if tgt not in new_nodes or graph_score > new_nodes[tgt]["graph_score"]:
                    new_nodes[tgt] = info

            if edge_cap_hit:
                break

        reached.update(new_nodes)
        ranked = sorted(new_nodes.items(), key=lambda kv: -kv[1]["graph_score"])
        frontier = [u for u, _ in ranked[:MAX_FRONTIER]]

        print(f"New nodes discovered  : {len(new_nodes)}")
        print(f"Edges so far          : {len(all_edges)}")
        print(f"Next frontier size    : {len(frontier)}")

        if edge_cap_hit:
            print(f"MAX_EDGES reached: {MAX_EDGES}")
            break

    return reached, all_edges


# ----------------------------------------------------------
# 4. Run
# ----------------------------------------------------------
if not seeds:
    print("No KG seeds available - nothing to traverse.")
    reached_nodes, all_edges = {}, []
else:
    print("Seeds:")
    for i, s in enumerate(seeds, start=1):
        print(f"  {i}. {s['label']}  (score {s['score']:.3f}, "
              f"{s['match_type']}, phrase: {s['phrase']})")
    reached_nodes, all_edges = traverse(seeds)

    if BEST_PATH_EDGES_ONLY:
        all_edges = [
            e for e in all_edges
            if e["target"] in reached_nodes
            and reached_nodes[e["target"]]["parent"] == e["source"]
        ]

# ----------------------------------------------------------
# 5. Summary
# ----------------------------------------------------------
n_hop = defaultdict(int)
for r in reached_nodes.values():
    n_hop[r["hop"]] += 1
no_text = [u for u in reached_nodes if u not in node_content]

print("\n" + "=" * 80)
print("TRAVERSAL RESULT")
print("=" * 80)
print(f"Seeds                   : {n_hop[0]}")
for h in range(1, MAX_HOPS + 1):
    print(f"Hop {h} nodes             : {n_hop[h]}")
print(f"Edges followed          : {len(all_edges)}  (best-path only: {BEST_PATH_EDGES_ONLY})")
print(f"Reached nodes WITHOUT text : {len(no_text)} of {len(reached_nodes)}  (fetched in a later cell)")

# ----------------------------------------------------------
# 6. Tree view
# ----------------------------------------------------------
if reached_nodes:
    children = defaultdict(list)
    for u, r in reached_nodes.items():
        if r["parent"] is not None:
            children[r["parent"]].append(u)

    def print_tree(u, depth=0):
        r = reached_nodes[u]
        arrow = "" if depth == 0 else f"--{r['predicate']} (strength {r['strength']})--> "
        note = "" if u in node_content else "  [no text]"
        print("    " * depth + arrow + r["label"]
              + f"  (hop {r['hop']}, score {r['graph_score']:.3f})" + note)
        for c in sorted(children[u], key=lambda x: -reached_nodes[x]["graph_score"]):
            print_tree(c, depth + 1)

    print("\n" + "-" * 80)
    print("TRAVERSAL TREE")
    print("-" * 80)
    for s in seeds:
        print_tree(s["node"])

    # ------------------------------------------------------
    # 7. Edge table
    # ------------------------------------------------------
    edges_df = pd.DataFrame([
        {
            "hop": e["hop"],
            "source": label_of(e["source"]),
            "predicate": short(e["predicate"]),
            "target": label_of(e["target"]),
            "strength": e["strength"],
            "graph_score": round(e["graph_score"], 4),
        }
        for e in all_edges
    ])
    print()
    try:
        display(edges_df)          # Databricks
    except NameError:
        print(edges_df.to_string(index=False))

print("\n" + "=" * 80)
print("CELL 16B COMPLETED")
print("=" * 80)
