# ==========================================================
# CELL 16B — SEED → GROUNDING → OUTGOING TRAVERSAL
#
# Flow:
#
#   Seed Entity
#       ↓
#   Grounding to Source Document
#       ↓
#   Hop 1: Document → Target
#       ↓
#   Hop 2: New Target → Target
#
# No visualization
# No PyVis
# ==========================================================

from rdflib import URIRef
import pandas as pd

print("=" * 80)
print("CELL 16B — RDF OUTGOING GRAPH TRAVERSAL")
print("=" * 80)


# ==========================================================
# 1. CHECK REQUIRED VARIABLES
# ==========================================================

_REQUIRED = [
    "g",
    "seeds",
    "PREFIXES",
    "MAX_HOPS",
    "HOP_DECAY",
    "MAX_FRONTIER",
    "MAX_EDGES",
    "MIN_EDGE_STRENGTH",
]

_missing = [
    x for x in _REQUIRED
    if x not in globals()
]

if _missing:
    raise RuntimeError(
        f"Missing variables: {_missing}. "
        "Run Cell 13 and Cell 16A first."
    )


# ==========================================================
# 2. NODE LABEL
# ==========================================================

if "NODE_LABEL" in globals():
    node_label = NODE_LABEL

elif "label_index" in globals():
    node_label = label_index.node_label

else:
    node_label = {}


def get_label(node):

    node = str(node)

    return node_label.get(
        node,
        node.rsplit("/", 1)[-1]
    )


# ==========================================================
# 3. PRINT SEEDS
# ==========================================================

print("\nSEED NODES")
print("-" * 80)

for i, seed in enumerate(
    seeds,
    start=1
):

    print(
        f"{i}. {seed['label']} "
        f"(score={seed['score']:.2f})"
    )


# ==========================================================
# 4. GROUNDING QUERY
#
# Seed entity is normally rdf:object.
#
# Example:
#
# Document_A
#     |
#     | predicate
#     v
#    MTCC
#
# Therefore:
#
# rdf:object = MTCC
#
# gives us:
#
# rdf:subject = Document_A
# ==========================================================

GROUNDING_QUERY = PREFIXES + """

SELECT DISTINCT
       ?document
       ?predicate

WHERE {

    ?statement a rdf:Statement ;
               rdf:subject   ?document ;
               rdf:predicate ?predicate ;
               rdf:object    ?seed .

    ?document ex:documentContent ?content .
}
"""


# ==========================================================
# 5. OUTGOING QUERY
#
# After grounding, traversal is strictly:
#
# source → target
#
# using:
#
# rdf:subject = source
# rdf:object  = target
# ==========================================================

OUT_QUERY = PREFIXES + """

SELECT
       ?target
       ?predicate
       ?strength
       ?description
       ?linkType

WHERE {

    ?statement a rdf:Statement ;
               rdf:subject   ?source ;
               rdf:predicate ?predicate ;
               rdf:object    ?target .

    OPTIONAL {
        ?statement ex:strength ?strength .
    }

    OPTIONAL {
        ?statement ex:description ?description .
    }

    OPTIONAL {
        ?statement ex:linkType ?linkType .
    }

    FILTER(isIRI(?target))
}
"""


# ==========================================================
# 6. FIND DOCUMENTS FOR SEED
# ==========================================================

def ground_seed(seed):

    results = []

    seed_ref = URIRef(str(seed))

    for row in g.query(
        GROUNDING_QUERY,
        initBindings={
            "seed": seed_ref
        }
    ):

        results.append({
            "document": str(row.document),
            "predicate": str(row.predicate)
        })

    return results


# ==========================================================
# 7. GET OUTGOING EDGES
# ==========================================================

def outgoing(node):

    edges = []

    node_ref = URIRef(str(node))

    for row in g.query(
        OUT_QUERY,
        initBindings={
            "source": node_ref
        }
    ):

        # ----------------------------------------------
        # Strength
        # ----------------------------------------------

        try:
            strength = int(row.strength)

        except (TypeError, ValueError):
            strength = 0

        # ----------------------------------------------
        # Minimum strength filter
        # ----------------------------------------------

        if strength < MIN_EDGE_STRENGTH:
            continue

        edges.append({

            "source":
                str(node),

            "target":
                str(row.target),

            "predicate":
                str(row.predicate),

            "strength":
                strength,

            "description":
                (
                    str(row.description)
                    if row.description is not None
                    else ""
                ),

            "link_type":
                (
                    str(row.linkType)
                    if row.linkType is not None
                    else ""
                ),
        })

    return edges


# ==========================================================
# 8. INITIALIZE
# ==========================================================

reached = {}

all_edges = []

frontier = []


# ==========================================================
# 9. SEED → DOCUMENT GROUNDING
# ==========================================================

print("\n")
print("=" * 80)
print("SEED GROUNDING")
print("=" * 80)


for seed in seeds:

    seed_node = str(seed["node"])

    seed_label = seed["label"]

    seed_score = float(seed["score"])

    print(
        f"\nSeed: {seed_label}"
    )

    # ------------------------------------------------------
    # Find documents containing this seed
    # ------------------------------------------------------

    grounded_docs = ground_seed(
        seed_node
    )

    print(
        f"Grounding documents found: "
        f"{len(grounded_docs)}"
    )

    # ------------------------------------------------------
    # Add documents to frontier
    # ------------------------------------------------------

    for item in grounded_docs:

        document = item["document"]

        if document in reached:
            continue

        reached[document] = {

            "label":
                get_label(document),

            "hop":
                0,

            "root_seed":
                seed_node,

            "seed_score":
                seed_score,

            "path_strength":
                1.0,

            "graph_score":
                seed_score,

            "parent":
                seed_node,

            "predicate":
                item["predicate"],

            "strength":
                1.0,

            "description":
                "Seed grounding",

            "link_type":
                "grounding",
        }

        frontier.append(
            document
        )

        print(
            f"  → {get_label(document)}"
        )


# ==========================================================
# 10. HOP TRAVERSAL
# ==========================================================

for hop in range(
    1,
    MAX_HOPS + 1
):

    print("\n")
    print("=" * 80)
    print(f"HOP {hop}")
    print("=" * 80)

    print(
        f"Current frontier size: "
        f"{len(frontier)}"
    )

    if not frontier:

        print(
            "No nodes available."
        )

        break

    next_candidates = {}

    # ======================================================
    # EXPAND CURRENT FRONTIER
    # ======================================================

    for source in frontier:

        source_label = get_label(
            source
        )

        print(
            f"\nExpanding: "
            f"{source_label}"
        )

        # --------------------------------------------------
        # ONLY OUTGOING EDGES
        # --------------------------------------------------

        edges = outgoing(
            source
        )

        print(
            f"Outgoing edges found: "
            f"{len(edges)}"
        )

        # --------------------------------------------------
        # Traverse edges
        # --------------------------------------------------

        for edge in edges:

            if len(all_edges) >= MAX_EDGES:

                print(
                    "MAX_EDGES reached."
                )

                break

            target = edge["target"]

            # --------------------------------------------------
            # Do not revisit an already reached node
            # --------------------------------------------------

            if target in reached:
                continue

            parent = reached[
                source
            ]

            # --------------------------------------------------
            # Path strength
            # --------------------------------------------------

            edge_strength = max(
                edge["strength"],
                1
            )

            path_strength = (
                parent["path_strength"]
                *
                edge_strength
                /
                10.0
            )

            # --------------------------------------------------
            # Hop decay
            # --------------------------------------------------

            hop_decay = (
                1.0
                if hop == 1
                else HOP_DECAY
            )

            # --------------------------------------------------
            # Graph score
            # --------------------------------------------------

            graph_score = (
                parent["seed_score"]
                *
                path_strength
                *
                hop_decay
            )

            # --------------------------------------------------
            # Candidate
            # --------------------------------------------------

            candidate = {

                "node":
                    target,

                "label":
                    get_label(target),

                "hop":
                    hop,

                "root_seed":
                    parent["root_seed"],

                "seed_score":
                    parent["seed_score"],

                "path_strength":
                    path_strength,

                "graph_score":
                    graph_score,

                "parent":
                    source,

                "predicate":
                    edge["predicate"],

                "strength":
                    edge["strength"],

                "description":
                    edge["description"],

                "link_type":
                    edge["link_type"],
            }

            # --------------------------------------------------
            # Multiple parents may reach same node.
            # Keep strongest path.
            # --------------------------------------------------

            previous = next_candidates.get(
                target
            )

            if (
                previous is None
                or
                candidate["graph_score"]
                >
                previous["graph_score"]
            ):

                next_candidates[
                    target
                ] = candidate

            # --------------------------------------------------
            # Save edge
            # --------------------------------------------------

            all_edges.append({

                **edge,

                "hop":
                    hop,

                "graph_score":
                    graph_score,
            })

        if len(all_edges) >= MAX_EDGES:
            break

    # ======================================================
    # 11. RANK NEW NODES
    # ======================================================

    ranked_nodes = sorted(
        next_candidates.values(),
        key=lambda x: (
            -x["graph_score"],
            x["label"]
        )
    )

    # ======================================================
    # 12. FRONTIER LIMIT
    # ======================================================

    ranked_nodes = ranked_nodes[
        :MAX_FRONTIER
    ]

    # ======================================================
    # 13. SAVE REACHED NODES
    # ======================================================

    for item in ranked_nodes:

        reached[
            item["node"]
        ] = item

    # ======================================================
    # 14. NEXT FRONTIER
    # ======================================================

    frontier = [
        item["node"]
        for item in ranked_nodes
    ]

    # ======================================================
    # 15. PRINT NEW NODES
    # ======================================================

    print("\nNEW NODES")

    if not ranked_nodes:

        print(
            "No new nodes discovered."
        )

    else:

        for i, item in enumerate(
            ranked_nodes,
            start=1
        ):

            print(
                f"{i}. "
                f"{item['label']} "
                f"| strength={item['strength']} "
                f"| score={item['graph_score']:.4f}"
            )

    print(
        f"\nNext frontier size: "
        f"{len(frontier)}"
    )

    # ======================================================
    # STOP IF NOTHING NEW
    # ======================================================

    if not frontier:

        print(
            "Traversal stopped."
        )

        break


# ==========================================================
# 16. FINAL TRAVERSAL RESULT
# ==========================================================

print("\n")
print("=" * 80)
print("TRAVERSAL COMPLETE")
print("=" * 80)

print(
    f"Reached nodes : {len(reached)}"
)

print(
    f"Edges followed: {len(all_edges)}"
)


# ==========================================================
# 17. EDGE TABLE
# ==========================================================

if all_edges:

    edges_df = pd.DataFrame(
        all_edges
    )

    print("\nEDGE TABLE")
    print("-" * 80)

    display(
        edges_df[
            [
                "source",
                "target",
                "predicate",
                "strength",
                "hop",
                "graph_score"
            ]
        ]
    )

else:

    edges_df = pd.DataFrame()

    print(
        "\nNo edges were followed."
    )


# ==========================================================
# 18. REACHED NODE TABLE
# ==========================================================

if reached:

    reached_df = pd.DataFrame(
        [
            {
                "node": node,
                **info
            }
            for node, info
            in reached.items()
        ]
    )

    print("\nREACHED NODES")
    print("-" * 80)

    display(
        reached_df[
            [
                "node",
                "label",
                "hop",
                "graph_score",
                "parent",
                "predicate"
            ]
        ].sort_values(
            "graph_score",
            ascending=False
        )
    )

else:

    reached_df = pd.DataFrame()

    print(
        "No nodes reached."
    )
