# ==========================================================
# CELL 19 — TOP-K CHUNKS
# ==========================================================
#
# Input  : ranked_chunks (Cell 18)
#
# Output format:
#
# {
#     "predictions": [
#         {
#             "data": [
#                 {
#                     "content": "...",
#                     "title": "...",
#                     "reference": "..."
#                 }
#             ]
#         }
#     ]
# }
#
# ==========================================================

TOP_K = globals().get("TOP_K", 10)

if "ranked_chunks" not in globals():
    raise RuntimeError(
        "Missing 'ranked_chunks'. Run Cell 18 first."
    )


# ==========================================================
# 1. TAKE TOP-K FROM EXISTING RANK
# ==========================================================

chosen = ranked_chunks[:TOP_K]


# ==========================================================
# 2. BUILD EXACT REQUIRED FORMAT
# ==========================================================

result = {
    "predictions": [
        {
            "data": [
                {
                    "content": c["content"],
                    "title": c["node_name"],
                    "reference": c["source"]
                }
                for c in chosen
            ]
        }
    ]
}


# ==========================================================
# 3. DISPLAY
# ==========================================================

print("=" * 80)
print("CELL 19 — TOP-K CHUNKS")
print("=" * 80)

print(f"Total ranked chunks : {len(ranked_chunks)}")
print(f"TOP_K               : {TOP_K}")
print(f"Selected chunks     : {len(chosen)}")

print()
print(result)


# ==========================================================
# 4. FINAL OUTPUT
# ==========================================================

result
