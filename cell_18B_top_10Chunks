# ==========================================================
# CELL 19 — TOP-K CHUNKS
# ==========================================================
#
# Input  : ranked_chunks (Cell 18)
#
# Output format:
#
# {
#   "predictions": [
#     {
#       "data": [
#         {
#           "content": "...",
#           "title": "...",
#           "reference": "..."
#         }
#       ]
#     }
#   ]
# }
#
# ==========================================================

import json


# ==========================================================
# 1. CHECK REQUIRED VARIABLE
# ==========================================================

if "ranked_chunks" not in globals():
    raise RuntimeError(
        "Missing 'ranked_chunks'. Run Cell 18 first."
    )


# ==========================================================
# 2. TOP-K CONFIGURATION
# ==========================================================

TOP_K = globals().get("TOP_K", 10)


# ==========================================================
# 3. TAKE TOP-K FROM EXISTING RANK
# ==========================================================
#
# Cell 18 has already ranked all chunks.
# Here we simply take the first TOP_K chunks.
#
# No new scoring
# No MMR
# No re-ranking
#
# ==========================================================

chosen = ranked_chunks[:TOP_K]


# ==========================================================
# 4. BUILD REQUIRED OUTPUT STRUCTURE
# ==========================================================

result = {
    "predictions": [
        {
            "data": [
                {
                    "content": c["content"],
                    "title": c["node_name"],
                    "reference": c["source"]
                }
                for c in chosen
            ]
        }
    ]
}


# ==========================================================
# 5. SUMMARY
# ==========================================================

print("=" * 80)
print("CELL 19 — TOP-K CHUNKS")
print("=" * 80)

print(f"Total ranked chunks : {len(ranked_chunks)}")
print(f"TOP_K               : {TOP_K}")
print(f"Selected chunks     : {len(chosen)}")


# ==========================================================
# 6. PRETTY PRINT FINAL OUTPUT
# ==========================================================

print()
print("=" * 80)
print("FINAL TOP-K OUTPUT")
print("=" * 80)

print(
    json.dumps(
        result,
        indent=2,
        ensure_ascii=False
    )
)


# ==========================================================
# 7. FINAL VARIABLE
# ==========================================================

top_k_result = result
