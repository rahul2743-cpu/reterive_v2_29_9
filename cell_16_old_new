# ==========================================================
# Cell 16 : LINKING + TRAVERSAL  (SPARQL, no LLM)
#
#   Traversal now works like following Wikipedia links:
#       Hop 0 : seed node            (Doc A)
#       Hop 1 : nodes seed points to (B, C, D, F)
#       Hop 2 : nodes hop-1 nodes point to (G, K, L from B ; P, O from C)
#   Stops at hop 2. Follows OUTGOING edges only (source -> target).
#   Set HOP_DIRECTIONS to "both" for a hop if you also want incoming edges
#   (needed when the seed is a component/parameter and not a document).
# ==========================================================
print("=" * 80)
print("CELL 16 — LINKING + TRAVERSAL")
print("=" * 80)

# ---- traversal settings --------------------------------------------------
TRAVERSE_HOPS   = 2                          # hard stop at hop 2
HOP_DIRECTIONS  = {1: "out", 2: "out"}       # "out" = follow links, "both" = also incoming
HOP1_EDGE_SHARE = 0.6                        # hop 1 may use 60% of MAX_EDGES, rest kept for hop 2

_NEIGHBOUR_HEAD = """
SELECT ?src ?srcLabel ?pred ?predLabel ?tgt ?tgtLabel
       ?description ?strength ?linkType
WHERE {
    VALUES ?seed { %SEEDS% }
"""
_NEIGHBOUR_TAIL = """
          rdf:predicate ?pred ;
          ex:description ?description ;
          ex:strength    ?strength ;
          ex:linkType    ?linkType .
    OPTIONAL { ?src  rdfs:label ?srcLabel }
    OPTIONAL { ?tgt  rdfs:label ?tgtLabel }
    OPTIONAL { ?pred rdfs:label ?predLabel }
}
"""

# OUTGOING only: the frontier node is the subject (source) of the edge.
NEIGHBOUR_OUT_TMPL = PREFIXES + _NEIGHBOUR_HEAD + """
    ?stmt a rdf:Statement ;
          rdf:subject ?seed ;
          rdf:object  ?tgt ;
""" + _NEIGHBOUR_TAIL.replace("?src", "?seed_src").replace("?seed_src", "?src") + ""

# The query above binds ?src through this line:
NEIGHBOUR_OUT_TMPL = NEIGHBOUR_OUT_TMPL.replace(
    "OPTIONAL { ?src  rdfs:label ?srcLabel }",
    "BIND(?seed AS ?src)\n    OPTIONAL { ?src  rdfs:label ?srcLabel }")

# BOTH directions: original behaviour.
NEIGHBOUR_BOTH_TMPL = PREFIXES + _NEIGHBOUR_HEAD + """
    ?stmt a rdf:Statement ;
          rdf:subject ?src ;
          rdf:object  ?tgt ;
""" + _NEIGHBOUR_TAIL.replace(
    "OPTIONAL { ?src  rdfs:label ?srcLabel }",
    "FILTER(?src = ?seed || ?tgt = ?seed)\n    OPTIONAL { ?src  rdfs:label ?srcLabel }")

DOC_CONTENT_TMPL = PREFIXES + """
SELECT ?doc ?label ?content
WHERE {
    VALUES ?doc { %DOCS% }
    ?doc ex:documentContent ?content .
    OPTIONAL { ?doc rdfs:label ?label }
}
"""

SUBSTRING_TMPL = PREFIXES + """
SELECT DISTINCT ?node ?label
WHERE {
    ?node rdfs:label ?label .
    FILTER(CONTAINS(LCASE(STR(?label)), %PHRASE%))
    FILTER(!STRSTARTS(STR(?node), "%PREDMARK%"))
}
LIMIT 10
"""

_STOP = {"the", "a", "an", "of", "for", "and", "or", "to", "in", "on", "is",
         "are", "what", "which", "how", "does", "do", "with", "by", "from"}


def _tokens(s):
    return {t for t in re.findall(r"[a-z0-9]+", (s or "").lower())
            if t not in _STOP and len(t) > 2}


def _values_block(uris):
    return " ".join(f"<{u}>" for u in uris if "<" not in u and ">" not in u)


def _sparql_literal(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def link_entities(phrases):
    """Phrases -> [(node, label, score, phrase)]. Two passes: SPARQL
    substring for precision, fuzzy for recall."""
    best = {}
    for phrase, _cls in phrases:
        q = (SUBSTRING_TMPL
             .replace("%PHRASE%", _sparql_literal(phrase.lower()))
             .replace("%PREDMARK%", PREDICATE_MARKER))
        try:
            for row in g.query(q):
                node = str(row.node)
                if best.get(node, (0,))[0] < 95:
                    best[node] = (95.0, phrase)
        except Exception as e:
            print(f"  substring query failed for {phrase!r}: {e}")

        for label_lc, score in fuzzy_match(phrase.lower(), ALL_LABELS,
                                           MAX_SEEDS_PER_PHRASE, MATCH_CUTOFF):
            for node in LABEL_TO_NODES[label_lc]:
                if node not in best or score > best[node][0]:
                    best[node] = (score, phrase)

    return [(n, NODE_LABEL.get(n, n), s, p)
            for n, (s, p) in sorted(best.items(), key=lambda kv: kv[1][0], reverse=True)]


def lexical_fallback(question, limit=5):
    """No LLM, no embeddings. Used when extraction returns nothing or
    nothing links."""
    q_tokens = _tokens(question)
    if not q_tokens:
        return []
    scored = []
    for label_lc, nodes in LABEL_TO_NODES.items():
        overlap = q_tokens & _tokens(label_lc)
        if overlap:
            score = 100.0 * len(overlap) / max(len(_tokens(label_lc)), 1)
            for n in nodes:
                scored.append((n, NODE_LABEL.get(n, n), min(score, 99.0), "lexical"))
    scored.sort(key=lambda x: x[2], reverse=True)
    return scored[:limit]


def traverse(seeds):
    """
    Wikipedia-style expansion, one SPARQL query per hop, up to hop 2.
        hop 0 : seeds
        hop 1 : nodes the seeds link to
        hop 2 : nodes the hop-1 nodes link to
    Each node is expanded only once (its first hop), so no going back and
    no loops. Hop 1 cannot use the whole edge budget.
    """
    edges, seen = [], set()
    visited = {n: (0, s) for n, _l, s, _p in seeds}     # node -> (hop, seed_score)
    frontier = [n for n, _l, _s, _p in seeds]

    for hop in range(1, TRAVERSE_HOPS + 1):
        if not frontier or len(edges) >= MAX_EDGES:
            break
        block = _values_block(frontier[:MAX_FRONTIER])
        if not block:
            break

        direction = HOP_DIRECTIONS.get(hop, "out")
        tmpl = NEIGHBOUR_BOTH_TMPL if direction == "both" else NEIGHBOUR_OUT_TMPL
        try:
            rows = list(g.query(tmpl.replace("%SEEDS%", block)))
        except Exception as e:
            print(f"  hop {hop} query failed: {e}")
            break

        # strongest links first, so the per-hop cap keeps the best ones
        rows.sort(key=lambda r: int(r.strength), reverse=True)

        # hop 1 keeps a share of the budget back for hop 2
        cap = int(MAX_EDGES * HOP1_EDGE_SHARE) if hop < TRAVERSE_HOPS else MAX_EDGES

        next_frontier = []
        for row in rows:
            src, tgt = str(row.src), str(row.tgt)
            pred = str(row.predLabel) if row.predLabel else str(row.pred).rsplit("/", 1)[-1]
            key = (src, pred, tgt)
            if key in seen:
                continue
            seen.add(key)

            edges.append({
                "source": src,
                "source_label": str(row.srcLabel) if row.srcLabel else NODE_LABEL.get(src, src),
                "predicate": pred,
                "target": tgt,
                "target_label": str(row.tgtLabel) if row.tgtLabel else NODE_LABEL.get(tgt, tgt),
                "description": str(row.description),
                "strength": int(row.strength),
                "link_type": str(row.linkType),
                "hop": hop,
                "seed_score": max(visited.get(src, (0, 0))[1], visited.get(tgt, (0, 0))[1]),
            })

            for other in (src, tgt):
                if other not in visited:             # first time seen -> expand next hop
                    visited[other] = (hop, edges[-1]["seed_score"])
                    next_frontier.append(other)

            if len(edges) >= cap:
                break
        frontier = next_frontier

    return edges, visited


