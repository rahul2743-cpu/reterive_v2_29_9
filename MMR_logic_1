CHUNK_OVERLAP = 50 # chars to carry from the end of one chunk into the start of the next
MMR_LAMBDA = 0.92  # raised from 0.82: less MMR diversity pressure, quality chunks dominate
TOP_EDGES_PER_DOC = 5

STOP = {
