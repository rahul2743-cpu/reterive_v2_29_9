}
MARKUP = re.compile(r"\[?<doc:(?:\w{8})\]?>|") 

# ========== GENERIC WEIGHTS CONFIGURATION ==========
GENERIC_WEIGHTS = (0.45, 0.35, 0.20) # Default (can update from grid-search or regression)

def get_weights(query, seeds, query_tokens):
    """
    Optionally adapt weights depending on query/seeds;
    Otherwise just return GENERIC_WEIGHTS.
    """
    n_seeds = len(seeds)
    if n_seeds >= 3:
        return (0.35, 0.45, 0.20)
    elif n_seeds == 0:
        return (0.8, 0.1, 0.1)
    else:
        return GENERIC_WEIGHTS

# ========== HELPERS ==========
def tokens(text):
    return {
        w for w in re.findall(r"[a-z0-9]+", str(text or "").lower())
        if len(w) > 1 and w not in STOP
    }

def split_chunks(text):
    text = re.sub(r"\s+", " ", MARKUP.sub(" ", str(text or ""))).strip()
    if not text:
        return []
    sents = [
        s.strip()
        for s in re.split(r"(?<=[.!?])\s+", text)
        if s.strip()
    ]
    chunks, buf = [], ""
    for s in sents:
        if len(s) > CHUNK_SIZE:
            if len(buf) >= MIN_CHUNK:
                chunks.append(buf)
            buf = ""
            for i in range(0, len(s), CHUNK_SIZE):
                part = s[i:i + CHUNK_SIZE].strip()
                if len(part) >= MIN_CHUNK:
                    chunks.append(part)
        elif len(buf) + len(s) + 1 <= CHUNK_SIZE:
            buf = f"{buf} {s}".strip()
        else:
            if len(buf) >= MIN_CHUNK:
                chunks.append(buf)
            if CHUNK_OVERLAP and buf:
                raw_tail = buf[-CHUNK_OVERLAP:]
                space_idx = raw_tail.find(" ")
                tail = raw_tail[space_idx + 1:].strip() if space_idx != -1 else raw_tail.strip()
                buf = f"{tail} {s}".strip() if len(tail) + len(s) + 1 <= CHUNK_SIZE else s
            else:
                buf = s
    if len(buf) >= MIN_CHUNK:
        chunks.append(buf)
    return chunks

def jaccard(a, b):
    union = a | b
    return len(a & b) / len(union) if union else 0.0

if "fuzzy_match" not in globals():
    def fuzzy_match(query, choices, limit=3, cutoff=72):
        query = str(query or "").lower().strip()
        scores = []
        for choice in choices:
            c = str(choice or "").lower().strip()
            if not c: continue
            score = SequenceMatcher(None, query, c).ratio() * 100
            if score >= cutoff:
                scores.append((choice, score))
        return sorted(scores, key=lambda x: x[1], reverse=True)[:limit]

